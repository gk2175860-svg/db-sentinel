# Application
APP_NAME=db-sentinel
APP_ENV=production
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# Database
DATABASE_URL=sqlite+aiosqlite:///./db_sentinel.db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# JWT Authentication (REQUIRED - generate with: openssl rand -hex 32)
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Encryption (REQUIRED - generate with: openssl rand -hex 32)
ENCRYPTION_KEY=your-32-char-encryption-key

# Admin User
SEED_ADMIN_EMAIL=admin@db-sentinel.io
SEED_ADMIN_PASSWORD=your-secure-admin-password

# Registration
ALLOW_REGISTRATION=false

# AI Providers (optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_DEFAULT_MODEL=llama3.1:8b
AI_DEFAULT_PROVIDER=ollama
AI_PREFER_LOCAL=true
AI_COST_LIMIT_PER_DAY=10.0

# Task Queue
TASK_QUEUE_DEFAULT_TIMEOUT=300
TASK_QUEUE_MAX_RETRIES=3
WORKER_CONCURRENCY=4

# WebSocket
WS_HEARTBEAT_INTERVAL=30
WS_MAX_CONNECTIONS=1000

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090
SENTRY_DSN=

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ALLOW_CREDENTIALS=true